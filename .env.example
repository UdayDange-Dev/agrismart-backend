# Agrismart API configuration. Copy to `.env` for local development (never commit it).
# On Render, set these as Environment Variables in the dashboard. Secrets are marked
# `sync: false` in render.yaml, are entered there by hand and are never stored in Git.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
# Local: 127.0.0.1. Render: 0.0.0.0 (Render routes traffic to the service port).
HOST=127.0.0.1
# Render sets PORT itself; do not set it there.
PORT=4000
# Reverse-proxy hops in front of the API. Used only when ORIGIN_SHARED_SECRET is NOT set
# (local dev: 0). Behind Vercel + the origin gate, the visitor IP comes from the gate instead.
TRUST_PROXY=0
LOG_LEVEL=info

# Comma-separated list of exact origins allowed to call the API from a browser.
# Development: the Vite dev server. Production: the storefront origin, e.g. https://shop.example.com
# (https only). Vercel preview URLs are deliberately not listed: previews can browse but not write.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Shared secret proving a request came through the frontend proxy (Vercel). REQUIRED in production:
# requests without it get 403, except GET /api/health and /api/health/ready (platform probes).
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Set the SAME value as ORIGIN_SECRET in the Vercel project (a server-side variable, NOT VITE_).
# Leave empty for local development.
ORIGIN_SHARED_SECRET=

# --- MongoDB ---------------------------------------------------------------
# A dedicated least-privilege user (readWrite on this database only), with separate databases
# AND users for testing and production. MongoDB Atlas: mongodb+srv://... (TLS).
MONGODB_URI=mongodb://agrismart_app:replace-me@127.0.0.1:27017/agrismart?authSource=agrismart

# --- ERPNext ---------------------------------------------------------------
# Site root only (no path/query). Must use https in production.
# Test and staging deployments use a SEPARATE test ERPNext site, never the production site.
ERPNEXT_BASE_URL=https://erp.example.com/
# Host allowlist; ERPNEXT_BASE_URL's host must appear here (SSRF guard).
ERPNEXT_ALLOWED_HOSTS=erp.example.com
# API key/secret of a DEDICATED least-privilege ERPNext API user, one per site (see SECURITY.md).
ERPNEXT_API_KEY=replace-me
ERPNEXT_API_SECRET=replace-me
# Selling price list used for website prices (exact ERPNext name). Verified at startup/refresh
# to exist, be enabled and be a selling list. REQUIRED in production (no assumed default);
# `npm run erpnext:verify` lists the enabled selling price lists on the site.
ERPNEXT_PRICE_LIST=replace-with-your-selling-price-list
# true  = read selling prices (Item Price) from ERPNEXT_PRICE_LIST.
# false = no prices: Price List / Item Price are never requested (no permission needed),
#         ERPNEXT_PRICE_LIST is not required, every product shows "Ask for price" and
#         cannot be added to an order request (customers send an inquiry instead).
ERPNEXT_PRICE_SYNC=true
# website_item: only Website Items with published=1 (ERPNext v14+/webshop app)
# item: all enabled sales Items (use ERPNEXT_ITEM_GROUPS to restrict)
ERPNEXT_CATALOG_SOURCE=website_item
# Optional comma-separated Item Group allowlist, e.g. Seeds,Fertilizers
ERPNEXT_ITEM_GROUPS=
ERPNEXT_TIMEOUT_MS=8000
# Timezone of the ERPNext site; used for Item Price validity dates.
ERPNEXT_TIMEZONE=Asia/Kolkata
# Optional: an EXISTING "Lead Source" record name in ERPNext (leave blank if unsure).
ERPNEXT_LEAD_SOURCE=
# Attach the inquiry message to the Lead as an (HTML-escaped) Comment.
ERPNEXT_LEAD_ADD_COMMENT=true
# true  = website inquiries create ERPNext Leads (production behaviour).
# false = read-only: nothing is ever written to ERPNext; inquiries stay queued in MongoDB and are
#         sent once this is switched back to true. `npm run dev:erp` always forces false.
ERPNEXT_LEAD_SYNC=true
# E-commerce User registry: copy customer accounts (no passwords or tokens) to the custom
# ERPNext DocType "E-commerce User". Keep false until the DocType and the E-commerce Integration
# role exist on the site (erpnext/README.md). While false, changes are queued locally and
# existing accounts are backfilled once it is switched on. `npm run dev:erp` always forces false.
ERPNEXT_USER_SYNC=false
# Exact hostname of the ERPNext site this server may WRITE to (Leads, Comments, E-commerce User).
# Fail closed: with ERPNEXT_LEAD_SYNC or ERPNEXT_USER_SYNC on, the API refuses to start unless
#  - production site: NODE_ENV=production AND this equals the host (e.g. asfsl.sanvidhierp.in);
#  - staging site: this equals the staging host;
#  - local stub (127.0.0.1 / localhost): allowed in development without it.
# Local development can never write to the production site. Bare hostname only: no scheme or port.
ERPNEXT_WRITE_APPROVED_HOST=

# --- Customer accounts: links in emails + outgoing mail ---------------------
# Public storefront origin used in verification / password-reset links (https in production).
APP_PUBLIC_URL=http://127.0.0.1:5173
# Required in production. In development, leave SMTP_HOST empty and emails are printed to
# the API console instead of being sent. With SMTP_HOST set, `npm run dev` sends REAL email
# (the dev:mock / dev:erp stacks and the automated tests never do).
#
# Two supported modes (anything else is rejected at startup):
#   SMTP_PORT=465 + SMTP_SECURE=true   implicit TLS ("SSL/TLS"), e.g. a cPanel mailbox
#   SMTP_PORT=587 + SMTP_SECURE=false  STARTTLS, which the app then requires (no plaintext)
# Example for a cPanel mailbox (placeholders):
#   MAIL_FROM=Agrismart <shop@your-domain.example>
#   SMTP_HOST=mail.your-domain.example
#   SMTP_PORT=465
#   SMTP_SECURE=true
#   SMTP_USER=shop@your-domain.example
#   SMTP_PASS=<mailbox password, set only in the real .env>
# Check with `npm run build && npm run mail:check` (connects + authenticates, sends nothing), then
# `npm run mail:check -- --send-to you@your-domain.example` (sends ONE test email).
MAIL_FROM=Agrismart <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Caching / jobs / sessions --------------------------------------------
CATALOG_CACHE_TTL_SECONDS=300
CATALOG_MAX_STALE_SECONDS=3600
INQUIRY_SYNC_INTERVAL_SECONDS=60
# Back-office (staff) sessions: absolute lifetime and idle timeout
SESSION_TTL_HOURS=8
STAFF_SESSION_IDLE_MINUTES=30
# Customer sessions: absolute lifetime and idle timeout
CUSTOMER_SESSION_TTL_HOURS=168
CUSTOMER_SESSION_IDLE_HOURS=24
